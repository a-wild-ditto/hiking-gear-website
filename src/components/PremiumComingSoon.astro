---
const { compact = false } = Astro.props as { compact?: boolean };
---

<article
  class:list={['premium-coming-soon', { compact }]}
  id={compact ? undefined : 'premium'}
>
  <span class="eyebrow">Coming soon</span>
  <h3>Premium</h3>
  <p>
    A carefully researched kit for more demanding trips is in the works. We
    haven't selected or tested its gear yet, so there are no product, price or
    warmth claims to compare.
  </p>
  {
    compact && (
      <a class="text-link" href="/starter-kits#premium">
        About the Premium kit
      </a>
    )
  }
</article>
