---
import type { Product } from '../data/catalog';
import { formatWeight } from '../data/catalog';
import Photo from './Photo.astro';
import type { ProductPage } from '../data/product-pages/types';
const {
  product: p,
  productPage,
  href,
  priceLabel = 'What we paid',
} = Astro.props as {
  product?: Product;
  productPage?: ProductPage;
  href?: string;
  priceLabel?: string;
};
const name = productPage?.name ?? p?.name ?? '';
const summary = productPage?.summary ?? p?.summary ?? '';
const imageId = productPage?.imageId ?? p?.id;
const price = productPage
  ? `A$${productPage.pricePaidAud.toFixed(2)}`
  : `A$${p?.price}`;
const weight = formatWeight(p?.carriedWeightGrams);
const evidence = productPage
  ? productPage.review.state === 'published'
    ? 'Field review published'
    : 'Field test pending'
  : p?.weightStatus === 'seller-claim'
    ? 'Seller claim'
    : p?.weightStatus === 'unknown'
      ? 'Weight to verify'
      : 'Listed weight';
---

<article class="product-card">
  <div class="product-thumb">
    {
      href ? (
        <a href={href} tabindex="-1" aria-hidden="true">
          <Photo
            productId={imageId}
            alt={name}
            sizes="(max-width: 767px) 96px, 300px"
            widths={[200, 400, 640]}
          />
        </a>
      ) : (
        <Photo
          productId={imageId}
          alt={name}
          sizes="(max-width: 767px) 96px, 300px"
          widths={[200, 400, 640]}
        />
      )
    }
  </div>
  <div class="product-body">
    <p class="product-status">{productPage?.tags[0] ?? p?.category}</p>
    <h3>{href ? <a href={href}>{name}</a> : name}</h3>
    <p>{summary}</p>
    {p?.goodFor && <p class="product-for">Good for: {p.goodFor}</p>}
    {
      p?.keyFact && (
        <p class="product-fact">
          <>
            <strong>{p.keyFact.label}</strong>
            <span>{p.keyFact.meaning}</span>
          </>
        </p>
      )
    }
    <dl class="figures">
      <div><dt>{priceLabel}</dt><dd>{price}</dd></div>
      {
        !productPage && (
          <div>
            <>
              <dt>Carried weight</dt>
              <dd>{weight}</dd>
            </>
          </div>
        )
      }
    </dl>
    <p class="small-print">
      {evidence}{productPage && `, researched ${productPage.researchedOn}`}
    </p>
    {
      href && (
        <a class="text-link" href={href}>
          See our research
        </a>
      )
    }
  </div>
</article>
