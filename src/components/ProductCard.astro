---
import Photo from './Photo.astro';
import type { ProductPage } from '../data/product-pages/types';
import { publicProductStatus } from '../data/product-pages/public-status';
const {
  productPage,
  href,
  priceLabel = 'What we paid',
} = Astro.props as {
  productPage: ProductPage;
  href?: string;
  priceLabel?: string;
};
const name = productPage.name;
const summary = productPage.summary;
const imageId = productPage.imageId;
const price = `A$${productPage.pricePaidAud.toFixed(2)}`;
---

<article class="product-card">
  <div class="product-thumb">
    {
      href ? (
        <a href={href} tabindex="-1" aria-hidden="true">
          <Photo
            productId={imageId}
            alt={name}
            sizes="(max-width: 767px) 96px, 300px"
            widths={[200, 400, 640]}
          />
        </a>
      ) : (
        <Photo
          productId={imageId}
          alt={name}
          sizes="(max-width: 767px) 96px, 300px"
          widths={[200, 400, 640]}
        />
      )
    }
  </div>
  <div class="product-body">
    <p class="product-status">{productPage.tags[0] ?? productPage.category}</p>
    <h3>{href ? <a href={href}>{name}</a> : name}</h3>
    <p>{summary}</p>
    <dl class="figures">
      <div><dt>{priceLabel}</dt><dd>{price}</dd></div>
    </dl>
    <p class="small-print">
      {publicProductStatus(productPage.review)}, researched {
        productPage.researchedOn
      }
    </p>
    {
      href && (
        <a class="text-link" href={href}>
          See our research
        </a>
      )
    }
  </div>
</article>
