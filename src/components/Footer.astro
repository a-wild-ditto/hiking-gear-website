---
import { site } from '../config/site';
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/"><Wordmark /></a>
      <p>
        Practical gear guidance for Australians heading out on their first
        overnight hike.
      </p>
    </div>
    <div class="footer-col">
      <h2>Plan</h2><a href="/build-my-kit">Build My Kit</a><a
        href="/starter-kits">Starter Kits</a
      ><a href="/gear">Gear</a><a href="/learn">Learn</a>
    </div>
    <div class="footer-col">
      <h2>About</h2><a href="/about">About</a><a href="/contact">Contact</a><a
        href="/faq">FAQ</a
      >
    </div>
    <div class="footer-col">
      <h2>Legal</h2><a href="/privacy">Privacy</a><a
        href="/affiliate-disclosure">Affiliate disclosure</a
      ><a href="/terms">Terms</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span
      >© {new Date().getFullYear()}
      {site.brandName}. Validation prototype.</span
    ><span>Products and prices shown are demonstration data only.</span>
  </div>
</footer>
