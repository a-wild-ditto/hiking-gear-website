---
import { site } from '../config/site';
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/"><Wordmark /></a><p>
        Practical gear guidance for Australians heading out on their first
        overnight hike.
      </p>
    </div>
    <div class="footer-col">
      <h2>Explore</h2><a href="/starter-kits#value">Value Kit</a><a
        href="/starter-kits#starter">Starter Kit</a
      ><a href="/gear">Gear</a><a href="/learn">Guides</a><a
        href="/build-my-kit">Build My Kit</a
      >
    </div>
    <div class="footer-col">
      <h2>About</h2><a href="/about">About</a><a href="/about#how-we-choose"
        >How We Choose</a
      ><a href="/contact">Contact</a><a href="/faq">FAQ</a>
    </div>
    <div class="footer-col">
      <h2>Legal</h2><a href="/affiliate-disclosure">Affiliate Disclosure</a><a
        href="/privacy">Privacy</a
      ><a href="/terms">Terms</a>
    </div>
  </div><div class="container footer-bottom">
    <span
      >© {new Date().getFullYear()}
      {site.brandName}. Prices are historical or last checked; current merchant
      prices can change.</span
    ><span>Some links are affiliate links.</span>
  </div>
