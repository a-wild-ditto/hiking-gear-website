---
import {
  comparison,
  comparisonCheckedOn,
  comparisonRows,
  formatAud,
  formatKg,
  savings,
  type ComparisonRow,
} from '../data/retailer-comparison';

const groups = ['Shelter', 'Sleeping bag', 'Sleeping mat', 'Pack'] as const;
const rowsFor = (category: (typeof groups)[number]) =>
  comparisonRows.filter((row) => row.category === category);
const checkedDate = new Date(
  `${comparisonCheckedOn}T00:00:00Z`,
).toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const statusLabel: Record<ComparisonRow['weightStatus'], string> = {
  manufacturer: 'Published weight',
  retailer: 'Published weight',
  'seller-claim': 'Published weight',
  'comparison-estimate': 'Comparison estimate',
};
---

<section class="comparison-section" aria-labelledby="comparison-title">
  <div class="container comparison-grid">
    <div class="comparison-intro">
      <p class="eyebrow">Why Bush Gums exists</p>
      <h2 id="comparison-title">
        Your first overnight shouldn’t cost a small fortune.
      </h2>
      <p>
        The bush should be accessible to ordinary Australians, not only people
        ready to spend four figures on their first setup.
      </p>
      <p>
        Traditional outdoor retail often leaves beginners choosing between
        affordable gear that is heavy, compromised or poorly explained, and
        lighter gear that costs hundreds of dollars per item.
      </p>
      <p>
        Bush Gums searches beyond the big chains, checks specifications and
        owner evidence, and narrows the market to the best-value gear we can
        find. You pay less, see the compromises up front and get into the bush
        sooner.
      </p>
    </div>
    <div class="comparison-card">
      <div class="comparison-card-head">
        <p class="eyebrow">Category-matched snapshot</p>
        <h3>
          Pay {formatAud(savings.priceAud)} less. Carry about{' '}
          {formatKg(savings.weightGrams, 1)}{' '}less.
        </h3>
        <p>
          Our Value kit is approximately {
            formatAud(comparison.bushGums.priceAud)
          }{' '}
          and {formatKg(comparison.bushGums.weightGrams)}, compared with{' '}
          {formatAud(comparison.anaconda.priceAud)} and{' '}
          {formatKg(comparison.anaconda.weightGrams)} for a category-matched Anaconda
          setup.
        </p>
        <p class="small-print">
          Based on listed weights and retained carried-weight estimates, not a
          physical comparison by Bush Gums.
        </p>
      </div>
      <div class="comparison-metrics" aria-label="Comparison savings">
        <div>
          <span>Price</span>
          <strong>{formatAud(savings.priceAud)} less</strong>
          <small>{savings.pricePercent}% lower</small>
        </div>
        <div>
          <span>Estimated carried weight</span>
          <strong>{formatKg(savings.weightGrams, 1)} lower</strong>
          <small>{savings.weightPercent}% lower</small>
        </div>
      </div>
      <div class="comparison-values" aria-label="Comparison totals">
        <div>
          <span>Bush Gums Value</span>
          <strong>{formatAud(comparison.bushGums.priceAud)}</strong>
          <small>{formatKg(comparison.bushGums.weightGrams)}</small>
        </div>
        <div>
          <span>Anaconda setup</span>
          <strong>{formatAud(comparison.anaconda.priceAud)}</strong>
          <small>{formatKg(comparison.anaconda.weightGrams)}</small>
        </div>
      </div>
      <p class="comparison-savings">
        Save {formatAud(savings.priceAud)} with an estimated carried-weight difference
        of around {formatKg(savings.weightGrams, 1)}.
      </p>
      <a class="button" href="/starter-kits#value">See the Value Kit</a>
      <p class="small-print">
        Last checked <time datetime={comparisonCheckedOn}>{checkedDate}</time>.
        Prices exclude delivery.
      </p>
    </div>
  </div>
  <div class="container comparison-detail">
    <p>
      Category-matched comparison, not identical products. Prices and weight
      sources were checked on the dates shown and can change. Some carried
      weights are estimates; Bush Gums has not independently weighed every
      product. Construction, performance, warranty and retailer support can
      differ.
    </p>
    <details>
      <summary>How this comparison works</summary>
      <div class="comparison-table-wrap">
        <p>
          These are category-matched products rather than identical products.
          Bush Gums prices are what we paid or recorded. Anaconda figures are
          advertised sale or Club prices. The totals use estimated carried or
          packed weights from listed figures and retained estimates. The {
            formatKg(savings.weightGrams)
          }{' '}
          difference is calculated from retained comparison estimates, not from a
          Bush Gums physical measurement. Where an accessible product page did not
          expose a weight field, the retained figure is labelled as an estimate. Retailer
          warranty and support may differ from the researched products.
        </p>
        <p>
          The Anaconda Capsule retailer listing publishes a 7°C comfort and 2°C
          limit rating; Bush Gums has not independently verified those ratings.
          Its 990 g weight is retailer-listed, not a Bush Gums measurement. Bush
          Gums assigns no temperature rating to the generic 400 g down bag.
          Inspect each product's evidence notes before purchasing.
        </p>
        <table class="comparison-table">
          <caption>
            Rows used for the {formatAud(comparison.bushGums.priceAud)} versus{
              ' '
            }
            {formatAud(comparison.anaconda.priceAud)} comparison
          </caption>
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col">Bush Gums</th>
              <th scope="col">Anaconda</th>
            </tr>
          </thead>
          <tbody>
            {
              groups.map((category) => {
                const [bush, anaconda] = rowsFor(category);
                return (
                  <tr>
                    <th scope="row">{category}</th>
                    <td>
                      <strong>{bush.productName}</strong>
                      <small>
                        {formatAud(bush.priceAud)} · {bush.priceType} ·{' '}
                        {formatKg(bush.weightGrams)}
                      </small>
                      <small>
                        {statusLabel[bush.weightStatus]}: {bush.weightBasis}
                      </small>
                      <small>{bush.note}</small>
                      <a href={bush.sourceUrl}>Research and evidence notes</a>
                    </td>
                    <td>
                      <strong>{anaconda.productName}</strong>
                      <small>
                        {formatAud(anaconda.priceAud)} · {anaconda.priceType} ·{' '}
                        {formatKg(anaconda.weightGrams)}
                      </small>
                      <small>
                        {statusLabel[anaconda.weightStatus]}:{' '}
                        {anaconda.weightBasis}
                      </small>
                      <small>{anaconda.note}</small>
                      <a
                        href={anaconda.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Official product page
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </details>
  </div>
</section>
