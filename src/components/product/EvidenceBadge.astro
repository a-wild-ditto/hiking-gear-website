---
import type {
  EvidenceRelation,
  SpecStatus,
} from '../../data/product-pages/types';
type Props = {
  value: SpecStatus | EvidenceRelation;
  kind?: 'spec' | 'relation';
};
const { value, kind = 'spec' } = Astro.props as Props;
const labels: Record<string, string> = {
  measured: 'Measured by Bush Gums',
  manufacturer: 'Manufacturer spec',
  retailer: 'Retailer spec',
  corroborated: 'Multiple sources agree',
  'same-design':
    kind === 'relation'
      ? 'Same design — not confirmed as our unit'
      : 'Same-design reference',
  'seller-claim':
    kind === 'relation' ? 'Seller/listing claim' : 'Seller claim — unverified',
  'to-verify': 'To be verified',
  'exact-product': 'Exact product',
  'exact-model': 'Same model',
  'similar-design': 'Similar design only',
};
---

<span class:list={['evidence-badge', `evidence-${value}`]}>{labels[value]}</span
>
