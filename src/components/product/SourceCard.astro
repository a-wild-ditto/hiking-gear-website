---
import type { Source } from '../../data/product-pages/types';
import EvidenceBadge from './EvidenceBadge.astro';
const { source, number } = Astro.props as { source: Source; number: number };
const kindLabels: Record<Source['kind'], string> = {
  'written-review': 'Written review',
  forum: 'Forum',
  video: 'Video',
  blog: 'Blog',
  listing: 'Marketplace listing',
  retailer: 'Retailer',
  manufacturer: 'Manufacturer / brand',
};
---

<article class="source-card" id={`source-${source.id}`}>
  <div class="source-card-head">
    <span class="source-number">[{number}]</span><EvidenceBadge
      value={source.relation}
      kind="relation"
    />
  </div>
  <h3>
    {
      source.url ? (
        <a href={source.url} class="source-title" lang={source.lang}>
          {source.title}
        </a>
      ) : (
        <span class="source-title" lang={source.lang}>
          {source.title}
        </span>
      )
    }
  </h3>
  <p class="source-meta">
    {source.publisher} · {kindLabels[source.kind]}{
      !source.url && ' · no public link'
    }
  </p>
  <p>{source.summary}</p>
  {
    source.quote && (
      <blockquote>
        <span lang={source.lang}>“{source.quote}”</span>
        {source.quoteTranslation && (
          <span class="source-translation">
            <cite>Our translation from {source.language ?? source.lang}</cite>
            {source.quoteTranslation}
          </span>
        )}
      </blockquote>
    )
  }
</article>
