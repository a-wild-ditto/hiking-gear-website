---
import type { ReviewStatus as ProductReviewStatus } from '../../data/product-pages/types';
const { review } = Astro.props as { review: ProductReviewStatus };
---

{
  review.state === 'published' ? (
    <div class="review-panel review-published">
      <p>{review.verdict}</p>
      <dl class="review-facts">
        <>
          <div>
            <>
              <dt>Best for</dt>
              <dd>{review.bestFor}</dd>
            </>
          </div>
          <div>
            <>
              <dt>Not for</dt>
              <dd>{review.notFor}</dd>
            </>
          </div>
          <div>
            <>
              <dt>Conditions</dt>
              <dd>{review.conditions}</dd>
            </>
          </div>
        </>
      </dl>
      {review.notes.map((note) => (
        <p>{note}</p>
      ))}
    </div>
  ) : review.state === 'testing' ? (
    <div class="review-panel">
      <h3>Testing in progress</h3>
      <p>
        We are using this product and will add our own observations when we can
        describe the conditions and trade-offs clearly. The research below is
        not yet a Bush Gums recommendation.
      </p>
    </div>
  ) : (
    <div class="review-panel">
      <h3>Ordered for testing</h3>
      <p>
        We have ordered this product but have not used it on an overnight trip
        yet. Our view may change once we have lived with it outside.
      </p>
    </div>
  )
}
