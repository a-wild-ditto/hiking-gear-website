---
import type { SpecEntry } from '../../data/product-pages/types';
const { specs } = Astro.props as { specs: SpecEntry[] };
---

<table class="spec-table">
  <caption class="sr-only">Specifications</caption>
  <tbody>
    {
      specs.map((spec) => (
        <tr>
          <th scope="row">{spec.label}</th>
          <td>{spec.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>
