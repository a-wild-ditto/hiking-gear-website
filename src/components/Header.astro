---
import { primaryNav, site } from '../config/site';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
// Build My Kit is the header CTA, so the inline desktop links skip it.
const desktopLinks = primaryNav.filter((i) => i.href !== '/build-my-kit');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.brandName} home`}
      ><Wordmark /></a
    >
    <nav class="desktop-nav" aria-label="Primary">
      {
        desktopLinks.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? 'page' : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="button button-small desktop-cta" href="/build-my-kit"
      >Build My Kit</a
    >
    <details class="mobile-nav">
      <summary
        ><span class="sr-only">Open navigation</span><span
          class="burger"
          aria-hidden="true"><span></span><span></span></span
        ><span aria-hidden="true">Menu</span></summary
      >
      <nav aria-label="Mobile" class="mobile-panel">
        {
          primaryNav.map((item) => (
            <a
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/about">About</a><a href="/faq">FAQ</a>
      </nav>
    </details>
  </div>
</header>
