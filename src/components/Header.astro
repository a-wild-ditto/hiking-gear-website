---
import { primaryNav, site } from '../config/site';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.brandName} home`}
      ><Wordmark /></a
    >
    <nav class="desktop-nav" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? 'page' : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="button button-small desktop-cta" href="/starter-kits#value"
      >See the Value Kit</a
    >
    <details class="mobile-nav">
      <summary
        ><span class="sr-only">Open navigation</span><span
          class="burger"
          aria-hidden="true"><span></span><span></span></span
        ><span aria-hidden="true">Menu</span></summary
      ><nav aria-label="Mobile" class="mobile-panel">
        {
          primaryNav.map((item) => (
            <a
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
        <a class="mobile-panel-cta" href="/starter-kits#value"
          >See the Value Kit</a
        >
      </nav>
    </details>
  </div>
</header>
