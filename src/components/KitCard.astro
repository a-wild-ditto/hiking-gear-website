---
import { getKitWeight, type Kit } from '../data/kits';
import Photo from './Photo.astro';
// Compact kit row, used beside the featured kit on the homepage.
const { kit } = Astro.props as { kit: Kit };
---

<article class="kit-row">
  <div class="kit-row-media">
    <Photo
      slot="kitStarter"
      alt="BISINNA two-person tent with the Starter kit arranged at a Blue Mountains campsite"
      sizes="(max-width: 767px) 100vw, 24vw"
      widths={[400, 700]}
      label={`${kit.name} kit`}
    />
  </div>
  <div class="kit-row-head">
    <h3>{kit.name}</h3>
    <p>{kit.bestFor}</p>
  </div>
  <dl class="figures">
    <div>
      <dt>Est. total</dt><dd>${kit.price.toLocaleString('en-AU')}</dd>
    </div>
    <div>
      <dt>Approx. weight</dt><dd>{(getKitWeight(kit) / 1000).toFixed(1)} kg</dd>
    </div>
  </dl>
  <a class="text-link" href={`/starter-kits#${kit.id}`}
    >View the {kit.name} kit<span class="sr-only"> contents</span></a
  >
</article>
