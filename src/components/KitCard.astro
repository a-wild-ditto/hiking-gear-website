---
import { getKitWeight, type Kit } from '../data/kits';
const { kit, featured = false } = Astro.props as {
  kit: Kit;
  featured?: boolean;
};
---

<article class:list={['kit-card', { featured }]}>
  <div class="card-top">
    <span class="eyebrow">{kit.label}</span>{
      featured && <span class="pill">Best balance</span>
    }
  </div>
  <h3>{kit.name}</h3>
  <p class="price">
    <small>Approx.</small> ${kit.price.toLocaleString('en-AU')}
  </p>
  <p>{kit.summary}</p>
  <dl>
    <div>
      <dt>Demo base weight</dt><dd>
        {(getKitWeight(kit) / 1000).toFixed(1)} kg
      </dd>
    </div><div><dt>Best for</dt><dd>{kit.bestFor}</dd></div>
  </dl>
  <a class="text-link" href={`/starter-kits#${kit.id}`}
    >See what’s included <span aria-hidden="true">→</span></a
  >
</article>
