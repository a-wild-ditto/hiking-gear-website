---
import { getKitWeight, type Kit } from '../data/kits';
import Photo from './Photo.astro';

const { kit, featured = false } = Astro.props as {
  kit: Kit;
  featured?: boolean;
};
---

<article class:list={['kit-card', { featured }]} id={kit.id}>
  <div class="kit-card-media">
    <Photo
      slot={kit.id === 'value' ? 'kitFeatured' : 'kitStarter'}
      alt={`${kit.name} core overnight kit at an Australian campsite`}
      sizes="(max-width: 767px) 100vw, 42vw"
      widths={[480, 800]}
    />
  </div>
  <div class="kit-card-body">
    <p class="eyebrow">{kit.label}</p>
    <h3>{kit.name}</h3>
    <p>{kit.summary}</p>
    <dl class="figures figures-lg">
      <div>
        <dt>Recorded core-kit total</dt><dd>
          A${kit.price.toLocaleString('en-AU')}
        </dd>
      </div><div>
        <dt>Estimated carried weight</dt><dd>
          {(getKitWeight(kit) / 1000).toFixed(2)} kg
        </dd>
      </div>
    </dl>
    <a class="button" href={`/starter-kits#${kit.id}`}
      >View the {kit.name} kit</a
    >
    <p class="small-print">
      Prices are recorded context, not live offers. Mild-weather shortlist only.
    </p>
  </div>
</article>
