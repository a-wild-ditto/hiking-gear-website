---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kits, getKitWeight } from '../data/kits';
import { productById } from '../data/catalog';
import { questions } from '../data/questions';
import QuestionStep from '../components/QuestionStep.astro';

const resultData = Object.fromEntries(
  kits.map((kit) => [
    kit.id,
    {
      id: kit.id,
      name: kit.name,
      summary: kit.summary,
      bestFor: kit.bestFor,
      price: kit.price,
      weight: getKitWeight(kit),
      products: kit.productIds.map((id) => productById[id]),
    },
  ]),
);
---

<BaseLayout
  title="Build My Kit | Bush Gums"
  description="Answer six quick questions to compare the Starter and Value core hiking kits."
  noindex
>
  <section class="builder-wrap">
    <div class="container builder">
      <div class="builder-intro">
        <h1>Build My Kit</h1>
        <p class="lead">
          Six questions to compare the Starter and Value shortlists for your
          overnight hike.
        </p>
        <p class="small-print">
          <strong>No email or account needed.</strong> We use your answers to recommend
          a kit and to understand what hiking gear Australians are looking for.
        </p>
        <p class="small-print">
          Questionnaire responses and website interactions may be recorded for
          product research and analytics. We don't ask for your name or contact
          details. See our <a href="/privacy/">Privacy page</a>.
        </p>
        <p class="demo-note">
          This is a rules-based guide, not personalised hiking or safety advice.
        </p>
      </div>
      <div class="builder-panel">
        <form id="kit-builder" aria-label="Build My Kit questionnaire">
          <div class="progress" aria-hidden="true"><span></span></div>
          <p id="step-label" class="sr-only" aria-live="polite">
            Question 1 of {questions.length}
          </p>
          {
            questions.map((question, index) => (
              <QuestionStep
                question={question}
                index={index}
                total={questions.length}
                active={index === 0}
              />
            ))
          }
          <div class="builder-actions">
            <button
              class="button button-secondary"
              id="back"
              type="button"
              hidden>Back</button
            ><button class="button" id="next" type="button" disabled
              >Continue</button
            >
          </div>
        </form>
        <div id="result" class="result" aria-live="polite" tabindex="-1"></div>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ resultData }}>
    const form = document.querySelector('#kit-builder');
    const result = document.querySelector('#result');
    const steps = [...document.querySelectorAll('.question')];
    const next = document.querySelector('#next');
    const back = document.querySelector('#back');
    const progress = document.querySelector('.progress span');
    const label = document.querySelector('#step-label');
    let step = 0;
    let attempt = 0;
    const committed = new Map();
    const analytics = () => window.bushGumsAnalytics;
    const ensureAttempt = () => {
      if (!attempt) attempt = analytics()?.beginBuilderAttempt() || 0;
      return attempt;
    };
    const trackAnswer = (placement, questionStep, input) => {
      const currentAttempt = ensureAttempt();
      if (!currentAttempt || !input) return;
      const questionKey = steps[questionStep].dataset.key;
      const answerValue = input.value;
      if (placement === 'step_commit') {
        const key = `${currentAttempt}:${questionKey}`;
        if (committed.get(key) === answerValue) return;
        committed.set(key, answerValue);
      }
      analytics()?.track('builder_answer', {
        questionKey,
        answerValue,
        stepNumber: questionStep + 1,
        builderAttemptNumber: currentAttempt,
        placement,
      });
    };
    const selected = () => steps[step].querySelector('input:checked');
    const update = () => {
      steps.forEach((question, index) =>
        question.classList.toggle('active', index === step),
      );
      back.hidden = step === 0;
      next.textContent = step === steps.length - 1 ? 'Show my kit' : 'Continue';
      next.disabled = !selected();
      progress.style.width = `${((step + 1) / steps.length) * 100}%`;
      label.textContent = `Question ${step + 1} of ${steps.length}`;
    };
    update();
    let pointerPick = false;
    let advanceTimer;
    form.addEventListener('pointerdown', () => {
      pointerPick = true;
    });
    form.addEventListener('keydown', () => {
      pointerPick = false;
    });
    form.addEventListener('change', () => {
      ensureAttempt();
      next.disabled = false;
      if (!pointerPick) return;
      pointerPick = false;
      clearTimeout(advanceTimer);
      advanceTimer = setTimeout(
        () => next.click(),
        matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280,
      );
    });
    back.addEventListener('click', () => {
      clearTimeout(advanceTimer);
      step -= 1;
      update();
      (
        steps[step].querySelector('input:checked') ||
        steps[step].querySelector('input')
      ).focus();
    });
    next.addEventListener('click', () => {
      if (!selected()) return;
      trackAnswer('step_commit', step, selected());
      if (step < steps.length - 1) {
        step += 1;
        update();
        (
          steps[step].querySelector('input:checked') ||
          steps[step].querySelector('input')
        ).focus();
        return;
      }
      showResult();
    });
    function showResult() {
      const answers = Object.fromEntries(new FormData(form));
      if (answers.location === 'vic') {
        result.innerHTML = `<div class="result-header"><p class="result-kicker">No current match</p><h2>Check the route before choosing a kit</h2><p>Our kits are designed for non-alpine Australian conditions. The Victorian High Country can bring alpine weather at any time of year, so it needs route-specific gear.</p></div><div class="reasons"><h3>Why we are stopping here</h3><p>Check the route, forecast, shelter and sleeping system together before choosing gear for alpine areas.</p></div><div class="actions"><a class="button" href="/faq/" data-analytics-event="builder_result_click" data-builder-result="no_match" data-source-id="read_faq" data-placement="builder_result">Read the kit FAQ</a><button class="button button-secondary" id="restart" type="button">Start again</button></div>`;
        finish('no_match');
        return;
      }
      const scores = { starter: 0, value: 0 };
      const add = (kit, points) => {
        scores[kit] += points;
      };
      (
        ({
          'under-300': () => add('starter', 5),
          '300-500': () => {
            add('starter', 2);
            add('value', 3);
          },
          'over-500': () => add('value', 5),
        })[answers.budget] || (() => {})
      )();
      (
        ({
          'lowest-cost': () => {
            add('starter', 4);
            add('value', 1);
          },
          comfort: () => add('starter', 2),
          lightweight: () => add('value', 4),
        })[answers.priority] || (() => {})
      )();
      (
        ({
          nsw: () => add('starter', 1),
          vic: () => add('value', 2),
          tasmania: () => add('value', 2),
          queensland: () => add('starter', 1),
          other: () => add('value', 1),
        })[answers.location] || (() => {})
      )();
      if (answers.people === 'two') add('starter', 1);
      else add('value', 1);
      if (answers.experience === 'first') add('starter', 2);
      else add('value', 2);
      add('value', 2);
      const winter = answers.season === 'winter';
      const tasmania = answers.location === 'tasmania';
      const id =
        winter || tasmania
          ? 'value'
          : answers.people === 'two'
          ? 'starter'
          : scores.value >= scores.starter
            ? 'value'
            : 'starter';
      const kit = resultData[id];
      const kitScope =
        answers.people === 'two' && id === 'starter'
          ? 'one hiker plus the shared two-person shelter'
          : 'one hiker';
      const displayWeight = (grams) =>
        grams === undefined
          ? 'Not yet verified'
          : grams >= 1000
            ? `${(grams / 1000).toFixed(2)} kg`
            : `${grams} g`;
      const reasons = [
        answers.priority === 'lowest-cost'
          ? 'Your cost priority keeps the recommendation focused on the core spend.'
          : answers.priority === 'lightweight'
            ? answers.people === 'two' && id === 'starter'
              ? 'You prioritised lower weight, but the current two-person shelter is the deciding constraint.'
              : 'Your lower-weight priority gives the lighter Value shortlist extra weight.'
            : 'Your comfort priority keeps a roomier, simpler setup in consideration.',
        answers.budget === 'under-300'
          ? `Your budget sits closest to the A$${resultData.starter.price} Starter total.`
          : answers.budget === 'over-500'
            ? answers.people === 'two' && id === 'starter'
              ? 'Your budget leaves room for Value, but the current two-person shelter makes Starter the suitable match.'
              : `Your budget leaves room for the A$${resultData.value.price} Value shortlist.`
            : 'Your middle budget band keeps both current shortlists in play.',
        answers.people === 'two' && id === 'value'
          ? 'The Value kit tent sleeps one, so each hiker would carry their own.'
          : answers.people === 'two'
          ? 'Two hikers need the two-person Starter shelter in the current shortlist.'
          : 'For solo use, the lighter Value shelter receives a small advantage.',
        answers.experience === 'first'
          ? 'For a first overnight, the scoring favours a simpler, lower-cost starting point.'
          : 'Your previous overnight experience supports considering the more compact Value setup.',
      ];
      if (winter || tasmania) reasons.splice(0, reasons.length, reasons[2]);
      if (winter)
        reasons.unshift(
          'For winter, the Value kit suits most areas of Australia. Add a beanie and thermals, and put the Starter kit’s <a href="/gear/foil-egg-crate-foam-pad/">foam mat</a> under the R3.5 mat on colder nights.',
        );
      if (tasmania)
        reasons.unshift(
          'The Value kit is the better match for Tasmania. Alpine walks like the Overland Track need warmer gear, so check your route and forecast first.',
        );
      result.innerHTML = `<div class="result-header"><p class="result-kicker">Your suggested starting point</p><h2>The ${kit.name} kit</h2><p>${kit.summary}</p></div><dl class="figures figures-lg"><div><dt>Recorded core-kit total (${kitScope})</dt><dd>A$${kit.price.toLocaleString('en-AU')}</dd></div><div><dt>Estimated carried weight (${kitScope})</dt><dd>${(kit.weight / 1000).toFixed(1)} kg</dd></div><div class="figures-wide"><dt>Best for</dt><dd class="dd-text">${kit.bestFor}</dd></div></dl><div class="reasons"><h3>Why this result</h3><ul>${reasons.map((reason) => `<li>${reason}</li>`).join('')}</ul></div><details class="result-products"><summary>See the core kit contents (${kit.products.length} items)</summary><ul>${kit.products.map((product) => `<li><span><strong>${product.name}</strong><small>${product.category}, ${displayWeight(product.carriedWeightGrams)}</small></span><span class="mono">A$${product.price}</span></li>`).join('')}</ul></details><div class="actions"><a class="button" href="/#${id}" data-analytics-event="builder_result_click" data-builder-result="${id}" data-source-id="view_${id}" data-kit-id="${id}" data-placement="builder_result">View the ${kit.name} kit</a><a class="button button-secondary" href="/gear/" data-analytics-event="builder_result_click" data-builder-result="${id}" data-source-id="browse_gear" data-placement="builder_result">Browse the individual products</a><button class="button button-secondary" id="restart" type="button">Start again</button></div><p class="demo-note">Prices were recorded on the date shown on each product page. ${answers.people === 'two' && id === 'starter' ? "For two hikers, the displayed estimate covers one hiker's personal gear plus the shared shelter; the other hiker's personal gear is not included." : 'Cooking and comfort items are optional add-ons.'}</p>`;
      finish(id);
    }
    function finish(builderResult) {
      const currentAttempt = ensureAttempt();
      steps.forEach((question, questionStep) =>
        trackAnswer(
          'final_snapshot',
          questionStep,
          question.querySelector('input:checked'),
        ),
      );
      analytics()?.completeBuilderAttempt(currentAttempt);
      analytics()?.track('builder_result', {
        builderResult,
        builderAttemptNumber: currentAttempt,
      });
      form.hidden = true;
      result.classList.add('active');
      result.focus();
      result.querySelector('#restart').addEventListener('click', () => {
        form.reset();
        analytics()?.resetBuilderAttempt();
        attempt = 0;
        step = 0;
        form.hidden = false;
        result.classList.remove('active');
        update();
        steps[0].querySelector('input').focus();
      });
    }
  </script>
</BaseLayout>
