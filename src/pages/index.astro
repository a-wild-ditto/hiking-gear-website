---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import KitCard from '../components/KitCard.astro';
import ProductCard from '../components/ProductCard.astro';
import ValueComparison from '../components/ValueComparison.astro';
import { kitById } from '../data/kits';
import { productPageBySlug } from '../data/product-pages';

const valueProducts = [
  'naturehike-cloud-up-tent',
  '400g-down-envelope-sleeping-bag',
  'naturehike-tuye-r3-5',
  'naturehike-rock-60-5',
].map((slug) => productPageBySlug[slug]);
const chooseSteps = [
  [
    '01',
    'Find the value',
    'We look beyond the familiar outdoor chains for gear that seems unusually good for the money.',
  ],
  [
    '02',
    'See what owners think',
    'We read widely across owner experiences, independent reviews, forums and videos to find recurring strengths and problems.',
  ],
  [
    '03',
    'Take it outside',
    'Where we can, we buy the gear and use it ourselves in the Australian bush. That experience matters more to us than the logo.',
  ],
];
---

<BaseLayout
  title="Bush Gums | Affordable beginner overnight hiking gear Australia"
  description="Curated starter hiking kits and practical gear research for Australian beginners planning a first overnight trip."
>
  <section class="hero hero-funnel">
    <div class="hero-media">
      <Photo
        slot="hero"
        alt="A hiker beside a small tent on a sandstone ledge above a misty Blue Mountains valley at sunrise"
        sizes="100vw"
        widths={[768, 1280, 1942]}
        position="72% 55%"
        eager
      />
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Beginner overnight hiking gear, explained</p>
        <h1>Your first overnight hike, sorted.</h1>
        <p class="hero-sub">
          Start with a curated core overnight kit from A$218, or choose our
          lighter A$446 Value setup. We compare owner experiences and trade-offs
          so you can spend less without buying blind.
        </p>
        <div class="actions">
          <a class="button" href="/starter-kits#value">See the Value Kit</a><a
            class="button button-ghost"
            href="/gear">Browse the Gear</a
          >
        </div>
        <p class="trust-note">
          Affiliate links. Prices are historical and may change. Some
          specifications remain seller claims, and field testing is in progress.
        </p>
      </div>
    </div>
  </section>

  <ValueComparison />

  <section class="section" aria-labelledby="kits-title">
    <div class="container">
      <div class="heading-row">
        <div>
          <p class="eyebrow">Two ways to start</p><h2 id="kits-title">
            Choose the setup that fits your priorities.
          </h2>
        </div><a class="text-link" href="/starter-kits">Compare the kits</a>
      </div>
      <div class="kit-grid">
        <KitCard kit={kitById.value} featured /><KitCard
          kit={kitById.starter}
        />
      </div>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="method-title">
    <div class="container method-grid">
      <div>
        <p class="eyebrow">How we choose</p><h2 id="method-title">
          How Bush Gums chooses gear
        </h2><p>
          We still check the specs. We just care more about what the gear is
          actually like to own and use.
        </p><a class="text-link" href="/about#how-we-choose"
          >Read how we choose</a
        >
      </div>
      <ol class="method-steps">
        {
          chooseSteps.map(([number, title, copy]) => (
            <li>
              <>
                <span class="method-number">{number}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="heading-row">
        <div>
          <p class="eyebrow">Inside the Value kit</p><h2 id="featured-title">
            Real products, with the questions attached.
          </h2>
        </div><a class="text-link" href="/gear">See all gear</a>
      </div>
      <div class="product-grid">
        {
          valueProducts.map((product) => (
            <ProductCard
              productPage={product}
              href={`/gear/${product.slug}/`}
            />
          ))
        }
      </div>
      <p class="section-note">
        Every product page shows what we know, where it came from and what still
        needs testing.
      </p>
    </div>
  </section>

  <section class="builder-prompt" aria-labelledby="builder-title">
    <div class="container builder-prompt-inner">
      <div>
        <p class="eyebrow">Not sure which way to go?</p><h2 id="builder-title">
          Build My Kit can narrow it down.
        </h2><p>
          Answer a few trip questions in your browser. It recommends Starter or
          Value, and stops before winter conditions.
        </p>
      </div><a class="button button-light" href="/build-my-kit"
        >Try Build My Kit</a
      >
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="container final-cta-inner">
      <div>
        <p class="eyebrow">Ready to compare?</p><h2 id="final-title">
          See the Value kit, item by item.
        </h2><p>
          Follow each product into its research page, read what owners say and
          then choose an external merchant listing if it suits your trip.
        </p>
      </div><a class="button" href="/starter-kits#value">See the Value Kit</a>
    </div>
  </section>
</BaseLayout>
