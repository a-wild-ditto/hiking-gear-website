---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { kits, getKitWeight, optionalAddonIds } from '../data/kits';
import { productById, formatWeight } from '../data/catalog';
import { offersFor } from '../data/offers';
import { productPageBySlug, productPath } from '../data/product-pages';

const orderedKits = [...kits].sort((a, b) =>
  a.id === 'value' ? -1 : b.id === 'value' ? 1 : 0,
);
---

<BaseLayout
  title="Starter hiking kits | Bush Gums"
  description="Compare the Value and Starter core hiking kits for a first mild-weather overnight."
>
  <header class="page-hero">
    <div class="container page-hero-split">
      <div>
        <p class="eyebrow">Curated core setups</p><h1>Starter Kits</h1><p
          class="lead"
        >
          Compare two researched shelter, sleep and pack setups for a first
          mild-weather overnight. Cooking and comfort accessories remain
          optional.
        </p><div class="actions">
          <a class="button" href="/starter-kits#value">See the Value Kit</a><a
            class="button button-secondary"
            href="/build-my-kit">Build My Kit</a
          >
        </div><p class="small-print">
          Recorded prices, not live offers. Neither current kit is recommended
          for winter conditions.
        </p>
      </div><div class="page-hero-media">
        <Photo
          slot="kitsPage"
          alt="Two hikers making tea beside a tent among snow gums at sunset"
          sizes="(max-width: 767px) 100vw, 50vw"
          position="30% 65%"
          eager
        />
      </div>
    </div>
  </header>

  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <h2 id="compare-title" class="section-title">Compare at a glance</h2><div
        class="compare-scroll"
      >
        <table class="compare">
          <caption class="sr-only">Value and Starter kit comparison</caption
          ><thead
            ><tr
              ><th scope="col">Kit</th><th scope="col">Recorded total</th><th
                scope="col">Estimated carried weight</th
              ><th scope="col">Best for</th></tr
            ></thead
          ><tbody
            >{
              orderedKits.map((kit) => (
                <tr class:list={{ featured: kit.id === 'value' }}>
                  <>
                    <th scope="row">{kit.name}</th>
                    <td>A${kit.price.toLocaleString('en-AU')}</td>
                    <td>{(getKitWeight(kit) / 1000).toFixed(1)} kg</td>
                    <td>{kit.bestFor}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
      <div class="compare-cards" aria-label="Kit comparison summaries">
        {
          orderedKits.map((kit) => (
            <article
              class:list={{
                'compare-card': true,
                featured: kit.id === 'value',
              }}
            >
              <p class="eyebrow">{kit.name} kit</p>
              <h3>A${kit.price.toLocaleString('en-AU')}</h3>
              <p class="compare-card-note">{kit.bestFor}</p>
              <dl>
                <div>
                  <dt>Recorded total</dt>
                  <dd class="mono">A${kit.price.toLocaleString('en-AU')}</dd>
                </div>
                <div>
                  <dt>Estimated carried weight</dt>
                  <dd class="mono">
                    {(getKitWeight(kit) / 1000).toFixed(1)} kg
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-tint" aria-label="Kit contents">
    <div class="container kit-details">
      {
        orderedKits.map((kit) => (
          <article class="kit-detail" id={kit.id}>
            <>
              <div class="kit-detail-head">
                <>
                  <div class="kit-detail-art">
                    <img
                      src={`/illustrations/kit-${kit.id}-line.svg`}
                      alt=""
                      width="400"
                      height="200"
                    />
                  </div>
                  <p class="eyebrow">{kit.label}</p>
                  <h2>The {kit.name} kit</h2>
                  <p>{kit.summary}</p>
                  <dl class="figures">
                    <>
                      <div>
                        <>
                          <dt>Recorded core-kit total</dt>
                          <dd>A${kit.price.toLocaleString('en-AU')}</dd>
                        </>
                      </div>
                      <div>
                        <>
                          <dt>Estimated carried weight</dt>
                          <dd>{(getKitWeight(kit) / 1000).toFixed(1)} kg</dd>
                        </>
                      </div>
                    </>
                  </dl>
                </>
              </div>
              <ul class="kit-items">
                {kit.productIds.map((id) => {
                  const product = productById[id];
                  const page = product.reviewSlug
                    ? productPageBySlug[product.reviewSlug]
                    : undefined;
                  const offer = page ? offersFor(page.slug)[0] : undefined;
                  return (
                    <li>
                      <div class="kit-item-static">
                        <div class="kit-item-name">
                          <strong>
                            <a href={page ? productPath(page.slug) : '/gear'}>
                              {product.name}
                            </a>
                          </strong>
                          <small>{product.goodFor ?? product.summary}</small>
                        </div>
                        <span class="kit-item-cat">{product.category}</span>
                        <span class="mono">
                          {formatWeight(product.carriedWeightGrams)}
                        </span>
                        <span class="mono">A${product.price}</span>
                        {offer && page && (
                          <a class="kit-item-buy" href={productPath(page.slug)}>
                            Read research first
                          </a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
              <p class="small-print">
                Weights are estimated carried or packed figures, with provenance
                shown on each research page.
              </p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section optional-addons" aria-labelledby="addons-title">
    <div class="container">
      <p class="eyebrow">Add only if useful</p><h2 id="addons-title">
        Optional cookware and comfort
      </h2><p class="lead">
        These sit outside both kit totals. See the research before adding extra
        weight.
      </p><div class="addon-grid">
        {
          optionalAddonIds.map((id) => {
            const product = productById[id];
            const page = product.reviewSlug
              ? productPageBySlug[product.reviewSlug]
              : undefined;
            return (
              <article class="addon-card">
                <>
                  <span class="kit-item-cat">{product.category}</span>
                  <h3>{product.name}</h3>
                  <p>{product.summary}</p>
                  <a
                    class="text-link"
                    href={page ? productPath(page.slug) : '/gear'}
                  >
                    See our research
                  </a>
                </>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
