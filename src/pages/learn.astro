---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import Photo from '../components/Photo.astro';
import { guides } from '../data/guides';
---

<BaseLayout
  title="Beginner hiking guides | Bush Gums"
  description="Clear Australian beginner guides for choosing shelter, sleeping gear and a first overnight setup."
>
  <header class="page-hero">
    <div class="container page-hero-split">
      <div>
        <h1>Guides</h1>
        <p class="lead">
          Plain-English guides to the few gear decisions that shape warmth,
          comfort and pack weight.
        </p>
      </div>
      <div class="page-hero-media">
        <Photo
          slot="learnPage"
          alt="Two hikers on a boardwalk through Tasmanian button grass towards rocky mountains"
          sizes="(max-width: 767px) 100vw, 50vw"
          position="30% 55%"
          eager
        />
      </div>
    </div>
  </header>
  <section class="section">
    <div class="container learn-grid">
      <div class="guide-list">
        {guides.map((guide) => <GuideCard guide={guide} />)}
      </div>
      <aside class="learn-path" aria-labelledby="path-title">
        <h2 id="path-title">New to overnight hiking?</h2>
        <ol>
          <li>
            Start with <a href="/guides/overnight-hike-packing-list"
              >what you actually need</a
            >.
          </li>
          <li>
            Understand your <a href="/guides/sleeping-bag-temperature-ratings"
              >sleeping bag</a
            > and <a href="/guides/sleeping-mat-r-value">mat</a> together.
          </li>
          <li>
            Choose a <a href="/guides/2-person-hiking-tent-guide"
              >first tent</a
            > for real conditions.
          </li>
          <li>Then <a href="/#value">see the Value kit</a>.</li>
        </ol>
      </aside>
    </div>
  </section>
</BaseLayout>
