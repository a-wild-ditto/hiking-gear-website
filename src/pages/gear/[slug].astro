---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import SpecList from '../../components/product/SpecList.astro';
import SourceTable from '../../components/product/SourceTable.astro';
import OfferChoice from '../../components/product/OfferChoice.astro';
import OfferAlternatives from '../../components/product/OfferAlternatives.astro';
import { productPages, productPath } from '../../data/product-pages';
import { offersFor } from '../../data/offers';
import { site } from '../../config/site';
import { getProductPhoto } from '../../data/images';
import type {
  Finding,
  ProductPage,
  Source,
} from '../../data/product-pages/types';

export function getStaticPaths() {
  return productPages.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product: p } = Astro.props as { product: ProductPage };
const categoryAnchor =
  p.category === 'Cooking' || p.category === 'Accessories'
    ? 'cooking-accessories'
    : p.category.toLowerCase();
const productOffers = offersFor(p.slug);
// Offers arrive cheapest first. The cheapest is the primary button and every
// dearer offer is listed beneath it with its recorded price.
const offer = productOffers[0];
const primaryOffers = offer ? [offer] : [];
const alternativeOffers = productOffers.filter((o) => o !== offer);
const hasAliExpressOffer = productOffers.some(
  (o) => o.merchant === 'AliExpress',
);
const productPhoto = getProductPhoto(p.imageId);
const sourceNumbers = Object.fromEntries(
  p.sources.map((source, index) => [source.id, index + 1]),
) as Record<string, number>;
const experienceSource = (source: Source) =>
  ['written-review', 'forum', 'video', 'blog'].includes(source.kind) ||
  (source.kind === 'listing' && /buyer|customer|review/i.test(source.title));
const experienceIds = new Set(
  p.sources.filter(experienceSource).map((s) => s.id),
);
const fromExperience = (finding: Finding) =>
  finding.sourceIds.some((id) => experienceIds.has(id));
const ownerPositives = p.positives.filter(fromExperience);
const ownerNegatives = p.negatives.filter(fromExperience);
const date = new Date(`${p.researchedOn}T00:00:00`).toLocaleDateString(
  'en-AU',
  { day: 'numeric', month: 'long', year: 'numeric' },
);
const pricedOnDate = new Date(`${p.pricedOn}T00:00:00`).toLocaleDateString(
  'en-AU',
  {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  },
);
const datesMatch = p.pricedOn === p.researchedOn;
const pageUrl = new URL(productPath(p.slug), site.url).toString();
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Gear',
      item: new URL('/gear/', site.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: p.category,
      item: new URL(`/gear/#${categoryAnchor}`, site.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: p.name,
      item: pageUrl,
    },
  ],
};
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema,
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: p.name,
      description: p.metaDescription,
      dateModified: p.researchedOn,
      inLanguage: 'en-AU',
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Organization', name: site.brandName, url: site.url },
      publisher: {
        '@type': 'Organization',
        name: site.brandName,
        url: site.url,
      },
      about: { '@id': `${pageUrl}#product` },
      mainEntity: { '@id': `${pageUrl}#product` },
    },
    {
      '@type': 'Product',
      '@id': `${pageUrl}#product`,
      name: p.name,
      description: p.metaDescription,
      category: p.category,
      url: pageUrl,
      ...(productPhoto && {
        image: new URL(productPhoto.src, site.url).toString(),
      }),
    },
  ],
};
---

<BaseLayout
  title={`${p.seoTitle ?? p.name} | Bush Gums`}
  description={p.metaDescription}
  ogType="article"
  socialImage={productPhoto}
  socialImageAlt={productPhoto ? p.name : undefined}
  schema={pageSchema}
>
  <article class="product-page">
    <div class="container">
      <nav class="product-breadcrumbs" aria-label="Breadcrumb">
        <a href="/gear/">Gear</a><span aria-hidden="true">/</span><a
          href={`/gear/#${categoryAnchor}`}>{p.category}</a
        ><span aria-hidden="true">/</span><span aria-current="page"
          >{p.name}</span
        >
      </nav>
      <section
        class:list={{ 'product-hero': true, 'without-photo': !productPhoto }}
        aria-labelledby="product-title"
      >
        {
          productPhoto && (
            <div class="product-hero-media">
              <Photo
                productId={p.imageId}
                alt={p.name}
                sizes="(max-width: 767px) 100vw, 50vw"
                widths={[480, 800, 1200]}
                eager
              />
            </div>
          )
        }
        <div class="product-hero-copy">
          <p class="product-kicker">
            {p.category}
            {p.tags.length > 0 && <span>{p.tags.join(', ')}</span>}
          </p>
          <h1 id="product-title">{p.name}</h1>
          <p class="lead">{p.summary}</p>
          <p class="product-price">~A${p.pricePaidAud.toFixed(2)}</p>
          {
            p.pricedFrom && (
              <p class="product-price-source">
                Recorded {p.pricedFrom} price,{' '}
                <time datetime={p.pricedOn}>{pricedOnDate}</time>. The buy link
                below may show a different current price.
              </p>
            )
          }
          {
            offer && (
              <OfferChoice
                offers={primaryOffers}
                productSlug={p.slug}
                productCategory={p.category}
                placement="product_buy_primary"
                groupId="buy-hero"
              />
            )
          }
          <OfferAlternatives
            offers={alternativeOffers}
            productSlug={p.slug}
            productCategory={p.category}
            placement="product_buy_secondary"
          />
          {
            offer?.affiliate && (
              <p class="small-print">
                Affiliate link. We may earn a commission at no extra cost to
                you. <a href="/affiliate-disclosure/">Read the disclosure.</a>
              </p>
            )
          }
        </div>
      </section>
      <div class="product-body-grid">
        <aside class="product-rail" aria-label="On this page">
          <nav class="rail-nav">
            <p>On this page</p>
            <a href="#shortlist">Why we chose it</a>
            {
              p.externalReview && (
                <a href="#external-review">Independent external review</a>
              )
            }
            <a href="#specs">Technical specifications</a>
            <a href="#owners">What owners say</a>
            {
              p.buyerContext && (
                <a href="#buyer-context">{p.buyerContext.heading}</a>
              )
            }
            {
              p.thingsToKnow?.length ? (
                <a href="#trade-offs">Things to know</a>
              ) : null
            }
            <a href="#sources">Sources</a>
            <a href="#buy">Where to buy</a>
          </nav>
        </aside>
        <div class="product-content">
          <section class="product-section why-section" id="shortlist">
            <h2>Why we chose it</h2>
            <div class="prose">
              {p.whyWeChoseIt.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>

          {
            p.externalReview && (
              <section class="product-section" id="external-review">
                <h2>Independent external review</h2>
                {p.externalReview.note && (
                  <p class="external-review-note">{p.externalReview.note}</p>
                )}
                <div class="video-embed">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${p.externalReview.videoId}`}
                    title={p.externalReview.title}
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              </section>
            )
          }

          <section class="product-section" id="specs">
            <h2>Technical specifications</h2>
            <SpecList specs={p.specs} />
          </section>

          <section
            class="product-section"
            id="owners"
            aria-labelledby="owner-reports-title"
          >
            <h2 id="owner-reports-title">What owners and reviewers say</h2>
            <div class="finding-grid">
              <div>
                <h3>What people like</h3>
                {
                  ownerPositives.length ? (
                    <ul class="finding-list">
                      {ownerPositives.map((finding) => (
                        <li>
                          {finding.text}{' '}
                          {finding.sourceIds.map((id) => (
                            <a
                              href={`#source-${id}`}
                              aria-label={`Source ${sourceNumbers[id] ?? id}`}
                            >
                              [{sourceNumbers[id] ?? id}]
                            </a>
                          ))}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p>
                      We have not found enough first-hand reports to call out a
                      pattern yet.
                    </p>
                  )
                }
              </div>
              <div>
                <h3>What people question</h3>
                {
                  ownerNegatives.length ? (
                    <ul class="finding-list">
                      {ownerNegatives.map((finding) => (
                        <li>
                          {finding.text}{' '}
                          {finding.sourceIds.map((id) => (
                            <a
                              href={`#source-${id}`}
                              aria-label={`Source ${sourceNumbers[id] ?? id}`}
                            >
                              [{sourceNumbers[id] ?? id}]
                            </a>
                          ))}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p>No recurring complaint pattern has emerged yet.</p>
                  )
                }
              </div>
            </div>
            <p class="owner-context">{p.coverageNote}</p>
          </section>

          {
            p.buyerContext && (
              <section class="product-section" id="buyer-context">
                <h2>{p.buyerContext.heading}</h2>
                <div class="prose">
                  {p.buyerContext.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </section>
            )
          }

          {
            p.thingsToKnow && p.thingsToKnow.length > 0 && (
              <section class="product-section" id="trade-offs">
                <h2>Things to know</h2>
                <ul>
                  {p.thingsToKnow.map((item) => {
                    // Supports one inline [text](url) link per item.
                    const link = item.match(
                      /^(.*)\[([^\]]+)\]\(([^)]+)\)(.*)$/,
                    );
                    return link ? (
                      <li>
                        {link[1]}
                        <a
                          href={link[3]}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link[2]}
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                        {link[4]}
                      </li>
                    ) : (
                      <li>{item}</li>
                    );
                  })}
                </ul>
              </section>
            )
          }

          <section class="product-section" id="sources">
            <h2>Sources and reviews</h2>
            <div class="purchase-record">
              {p.identityNote && <p>{p.identityNote}</p>}
              <p>
                {
                  datesMatch ? (
                    <>
                      Recorded price A${p.pricePaidAud.toFixed(2)}, checked{' '}
                      <time datetime={p.pricedOn}>{pricedOnDate}</time>.
                    </>
                  ) : (
                    <>
                      Recorded price A${p.pricePaidAud.toFixed(2)} on{' '}
                      <time datetime={p.pricedOn}>{pricedOnDate}</time>.
                      Research was last checked{' '}
                      <time datetime={p.researchedOn}>{date}</time>.
                    </>
                  )
                }
              </p>
              {
                p.listingRating && (
                  <p>
                    The listing showed {p.listingRating.stars} out of 5 from{' '}
                    {p.listingRating.reviews.toLocaleString('en-AU')} reviews on{' '}
                    {p.listingRating.merchant} when checked on{' '}
                    {p.listingRating.checkedOn}. Read the individual buyer
                    comments for useful detail beyond the star rating.
                  </p>
                )
              }
            </div>
            <SourceTable sources={p.sources} numbers={sourceNumbers} />
          </section>

          <section class="product-section where-to-buy" id="buy">
            <h2>Where to buy</h2>
            {
              offer ? (
                <div>
                  <OfferChoice
                    offers={primaryOffers}
                    productSlug={p.slug}
                    productCategory={p.category}
                    placement="product_buy_where_to_buy"
                    groupId="buy-where"
                  />
                  <OfferAlternatives
                    offers={alternativeOffers}
                    productSlug={p.slug}
                    productCategory={p.category}
                    placement="product_buy_where_to_buy_secondary"
                  />
                  {offer.affiliate && (
                    <p class="small-print">
                      Affiliate link. We may earn a commission at no extra cost
                      to you. The merchant sets current price, stock, delivery,
                      returns and warranty.{' '}
                      <a href="/affiliate-disclosure/">Disclosure</a>
                    </p>
                  )}
                  {hasAliExpressOffer && (
                    <p class="buy-timing">
                      <strong>Worth knowing about timing.</strong> AliExpress
                      runs site-wide sale events through the year. Prices can be
                      lower during one, so if you are not in a hurry it is worth
                      checking whether the next sale is close.
                    </p>
                  )}
                </div>
              ) : (
                <p>
                  We have not added a buying link yet. We would rather confirm
                  the exact listing first.
                </p>
              )
            }
          </section>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
