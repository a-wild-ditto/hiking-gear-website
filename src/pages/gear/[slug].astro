---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import SpecList from '../../components/product/SpecList.astro';
import SourceCard from '../../components/product/SourceCard.astro';
import ReviewStatus from '../../components/product/ReviewStatus.astro';
import { productPages, productPath } from '../../data/product-pages';
import { publicProductStatus } from '../../data/product-pages/public-status';
import { offersFor } from '../../data/offers';
import { site } from '../../config/site';
import { getProductPhoto } from '../../data/images';
import type {
  Finding,
  ProductPage,
  Source,
} from '../../data/product-pages/types';

export function getStaticPaths() {
  return productPages.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product: p } = Astro.props as { product: ProductPage };
const categoryAnchor =
  p.category === 'Cooking' || p.category === 'Accessories'
    ? 'cooking-accessories'
    : p.category.toLowerCase();
const offer = offersFor(p.slug)[0];
const productPhoto = getProductPhoto(p.imageId);
const sourceNumbers = Object.fromEntries(
  p.sources.map((source, index) => [source.id, index + 1]),
) as Record<string, number>;
const experienceSource = (source: Source) =>
  ['written-review', 'forum', 'video', 'blog'].includes(source.kind) ||
  (source.kind === 'listing' && /buyer|customer|review/i.test(source.title));
const experienceIds = new Set(
  p.sources.filter(experienceSource).map((s) => s.id),
);
const fromExperience = (finding: Finding) =>
  finding.sourceIds.some((id) => experienceIds.has(id));
const ownerPositives = p.positives.filter(fromExperience);
const ownerNegatives = p.negatives.filter(fromExperience);
const otherNegatives = p.negatives.filter(
  (finding) => !fromExperience(finding),
);
const date = new Date(`${p.researchedOn}T00:00:00`).toLocaleDateString(
  'en-AU',
  { day: 'numeric', month: 'long', year: 'numeric' },
);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Gear',
      item: new URL('/gear/', site.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: p.category,
      item: new URL(`/gear/#${categoryAnchor}`, site.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: p.name,
      item: new URL(productPath(p.slug), site.url).toString(),
    },
  ],
};
---

<BaseLayout
  title={`${p.name} | Bush Gums`}
  description={p.metaDescription}
  schema={breadcrumbSchema}
>
  <article class="product-page">
    <div class="container">
      <nav class="product-breadcrumbs" aria-label="Breadcrumb">
        <a href="/gear/">Gear</a><span aria-hidden="true">/</span><a
          href={`/gear/#${categoryAnchor}`}>{p.category}</a
        ><span aria-hidden="true">/</span><span aria-current="page"
          >{p.name}</span
        >
      </nav>
      <section
        class:list={{ 'product-hero': true, 'without-photo': !productPhoto }}
        aria-labelledby="product-title"
      >
        {
          productPhoto && (
            <div class="product-hero-media">
              <Photo
                productId={p.imageId}
                alt={p.name}
                sizes="(max-width: 767px) 100vw, 50vw"
                widths={[480, 800, 1200]}
                eager
              />
            </div>
          )
        }
        <div class="product-hero-copy">
          <div class="tag-list">
            {p.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <p class="eyebrow">{p.category}</p>
          <h1 id="product-title">{p.name}</h1>
          <p class="lead">{p.summary}</p>
          {
            p.review.state === 'published' && (
              <p class="product-verdict">Our take: {p.review.verdict}</p>
            )
          }
          <dl class="status-block">
            <div>
              <dt>Bush Gums status</dt><dd>{publicProductStatus(p.review)}</dd>
            </div>
            <div>
              <dt>What we paid</dt><dd>
                A${p.pricePaidAud.toFixed(2)} recorded
              </dd>
            </div>
          </dl>
          {
            offer && (
              <a
                class="button"
                href={offer.url}
                target="_blank"
                rel={
                  offer.affiliate
                    ? 'sponsored noopener noreferrer'
                    : 'noopener noreferrer'
                }
              >
                Check current price on {offer.merchant}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
          {
            offer?.affiliate && (
              <p class="small-print">
                Affiliate link. We may earn a commission at no extra cost to
                you. <a href="/affiliate-disclosure/">Read the disclosure.</a>
              </p>
            )
          }
        </div>
      </section>
      <div class="product-content">
        <section class="product-section why-section">
          <p class="eyebrow">The short version</p>
          <h2>
            {
              p.review.state === 'published'
                ? 'Our take'
                : 'Why it made our shortlist'
            }
          </h2>
          <p class="question-line">{p.question}</p>
          <div class="prose">
            {p.whyWeChoseIt.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="product-section" aria-labelledby="owner-reports-title">
          <p class="eyebrow">Real-world reports</p>
          <h2 id="owner-reports-title">What owners and reviewers say</h2>
          <div class="finding-grid">
            <div>
              <h3>What people like</h3>
              {
                ownerPositives.length ? (
                  <ul class="finding-list">
                    {ownerPositives.map((finding) => (
                      <li>
                        {finding.text}{' '}
                        {finding.sourceIds.map((id) => (
                          <a
                            href={`#source-${id}`}
                            aria-label={`Source ${sourceNumbers[id] ?? id}`}
                          >
                            [{sourceNumbers[id] ?? id}]
                          </a>
                        ))}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p>
                    We have not found enough first-hand reports to call out a
                    pattern yet.
                  </p>
                )
              }
            </div>
            <div>
              <h3>What people question</h3>
              {
                ownerNegatives.length ? (
                  <ul class="finding-list">
                    {ownerNegatives.map((finding) => (
                      <li>
                        {finding.text}{' '}
                        {finding.sourceIds.map((id) => (
                          <a
                            href={`#source-${id}`}
                            aria-label={`Source ${sourceNumbers[id] ?? id}`}
                          >
                            [{sourceNumbers[id] ?? id}]
                          </a>
                        ))}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p>No recurring complaint pattern has emerged yet.</p>
                )
              }
            </div>
          </div>
          <p class="owner-context">{p.coverageNote}</p>
        </section>

        <section class="product-section">
          <p class="eyebrow">Useful specifications</p>
          <h2>What it promises</h2>
          <p class="section-intro">
            These figures help compare options. They describe what was listed or
            measured, not a guarantee of how this item will perform on your
            trip.
          </p>
          <SpecList
            specs={p.specs}
            sources={p.sources}
            sourceNumbers={sourceNumbers}
          />
        </section>

        <section class="product-section">
          <p class="eyebrow">Bush Gums experience</p>
          <h2>Our experience</h2>
          <ReviewStatus review={p.review} />
        </section>

        <section class="product-section split-lists">
          <div>
            <p class="eyebrow">Trade-offs</p>
            <h2>Things to know</h2>
            <ul>
              {
                otherNegatives.map((finding) => (
                  <li>
                    {finding.text}{' '}
                    {finding.sourceIds.map((id) => (
                      <a href={`#source-${id}`}>[{sourceNumbers[id] ?? id}]</a>
                    ))}
                  </li>
                ))
              }
              {p.watching.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Next steps</p>
            <h2>What we plan to check</h2>
            <ol>{p.testPlan.map((item) => <li>{item}</li>)}</ol>
          </div>
        </section>

        <section class="product-section">
          <p class="eyebrow">Read further</p>
          <h2>Sources and reviews</h2>
          <div class="purchase-record">
            {p.identityNote && <p>{p.identityNote}</p>}
            <p>
              We paid A${p.pricePaidAud.toFixed(2)}. This is historical purchase
              context, not a live offer. Research was last checked <time
                datetime={p.researchedOn}>{date}</time
              >.
            </p>
            {
              p.listingRating && (
                <p>
                  The listing showed {p.listingRating.stars} out of 5 from{' '}
                  {p.listingRating.reviews} reviews on{' '}
                  {p.listingRating.merchant} when checked on{' '}
                  {p.listingRating.checkedOn}. Read the individual buyer
                  comments for useful detail beyond the star rating.
                </p>
              )
            }
          </div>
          <div class="source-grid">
            {
              p.sources.map((source) => (
                <SourceCard source={source} number={sourceNumbers[source.id]} />
              ))
            }
          </div>
        </section>

        <section class="product-section where-to-buy">
          <p class="eyebrow">External merchant</p>
          <h2>Where to buy</h2>
          {
            offer ? (
              <div>
                <a
                  class="button"
                  href={offer.url}
                  target="_blank"
                  rel={
                    offer.affiliate
                      ? 'sponsored noopener noreferrer'
                      : 'noopener noreferrer'
                  }
                >
                  View current listing on {offer.merchant}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                {offer.affiliate && (
                  <p class="small-print">
                    Affiliate link. We may earn a commission at no extra cost to
                    you. The merchant sets current price, stock, delivery,
                    returns and warranty.{' '}
                    <a href="/affiliate-disclosure/">Disclosure</a>
                  </p>
                )}
              </div>
            ) : (
              <p>
                We have not added a buying link yet. We would rather check the
                exact listing first.
              </p>
            )
          }
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
