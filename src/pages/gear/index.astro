---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories } from '../../data/catalog';
import { productPages, productPath } from '../../data/product-pages';
import type { SlotName } from '../../data/images';
const groups: {
  title: string;
  id: string;
  slot: SlotName;
  alt: string;
  cats: string[];
}[] = [
  {
    title: 'Shelter',
    id: 'shelter',
    slot: 'shelter',
    alt: 'A dome tent pitched among snow gums',
    cats: ['Shelter'],
  },
  {
    title: 'Sleep',
    id: 'sleep',
    slot: 'sleep',
    alt: 'A sleeping bag and mat inside an open tent',
    cats: ['Sleep'],
  },
  {
    title: 'Packs',
    id: 'packs',
    slot: 'packs',
    alt: 'A hiker carrying an overnight pack on an alpine track',
    cats: ['Packs'],
  },
  {
    title: 'Cooking & accessories',
    id: 'cooking-accessories',
    slot: 'cooking',
    alt: 'A small stove boiling water on a rock at a campsite',
    cats: ['Cooking', 'Accessories'],
  },
];
---

<BaseLayout
  title="Beginner hiking gear | Bush Gums"
  description="A short, curated list of beginner overnight hiking gear, organised by the job each item does."
>
  <header class="page-hero">
    <div class="container narrow-left">
      <h1>Gear</h1>
      <p class="lead">
        A short list, organised by the job each item does. Start with what the
        trip needs.
      </p>
      <nav class="jump-links" aria-label="Gear categories">
        <a href="#ordered-for-testing">Bought for testing</a>
        {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
      <p class="demo-note">
        Products under “Bought for testing” are real items we’ve purchased. The
        rest of the catalogue is still demonstration data.
      </p>
    </div>
  </header>
  <div class="container">
    <section
      class="catalog-section ordered-section"
      id="ordered-for-testing"
      aria-labelledby="ordered-title"
    >
      <div class="catalog-head ordered-head">
        <div>
          <p class="eyebrow">Evidence-led product pages</p><h2
            id="ordered-title"
          >
            Bought for testing
          </h2><p>
            We bought these with our own money. Their pages show what we know
            before testing, with no field results yet.
          </p>
        </div>
      </div>
      <div class="catalog-grid">
        {
          productPages.map((productPage) => (
            <ProductCard
              productPage={productPage}
              href={productPath(productPage.slug)}
              priceLabel="Price we paid"
            />
          ))
        }
      </div>
    </section>
    <div class="catalog-demo-heading">
      <p class="eyebrow">Prototype catalogue</p><h2>
        Demonstration catalogue
      </h2><p>
        These remaining products, prices and ratings are demonstration data.
      </p>
    </div>
    {
      groups.map((group) => (
        <section
          class="catalog-section"
          id={group.id}
          aria-labelledby={`${group.id}-title`}
        >
          <div class="catalog-head">
            <div class="catalog-head-media">
              <Photo
                slot={group.slot}
                alt={group.alt}
                sizes="(max-width: 767px) 100vw, 30vw"
                label={group.title}
              />
            </div>
            <div>
              <h2 id={`${group.id}-title`}>{group.title}</h2>
              <p>{categories.find((c) => c.id === group.id)?.copy}</p>
            </div>
          </div>
          <div class="catalog-grid">
            {products
              .filter((p) => group.cats.includes(p.category))
              .map((p) => (
                <ProductCard product={p} />
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
