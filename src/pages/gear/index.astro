---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { productPages } from '../../data/product-pages';
import { getProductPhoto } from '../../data/images';

const categoryOrder = [
  { label: 'Shelter', id: 'shelter', matches: ['Shelter'] },
  { label: 'Sleep', id: 'sleep', matches: ['Sleep'] },
  { label: 'Packs', id: 'packs', matches: ['Packs'] },
  {
    label: 'Cooking & accessories',
    id: 'cooking-accessories',
    matches: ['Cooking', 'Accessories'],
  },
];
---

<BaseLayout
  title="Hiking gear research | Bush Gums"
  description="Practical research on affordable hiking gear for Australian beginners, with owner experiences, clear trade-offs and external merchant paths."
>
  <header class="page-hero">
    <div class="container page-hero-copy">
      <h1>Hiking gear research for Australian beginners</h1><p class="lead">
        Start with the category you need. Each page explains why the gear caught
        our eye, what owners report, what we have experienced so far and what to
        consider before following a merchant link.
      </p>
      <nav class="jump-links" aria-label="Gear categories">
        {
          categoryOrder
            .filter((c) =>
              productPages.some((p) => c.matches.includes(p.category)),
            )
            .map((c) => <a href={`#${c.id}`}>{c.label}</a>)
        }
      </nav>
    </div>
  </header>
  <section class="section">
    <div class="container gear-index">
      {
        categoryOrder.map((category) => {
          const group = productPages.filter((product) =>
            category.matches.includes(product.category),
          );
          return group.length ? (
            <section
              class="gear-category"
              id={category.id}
              aria-labelledby={`${category.id}-title`}
            >
              <>
                <div class="heading-row">
                  <>
                    <div>
                      <>
                        <h2 id={`${category.id}-title`}>
                          {category.label} research
                        </h2>
                      </>
                    </div>
                    <span class="small-print">
                      {group.length} researched{' '}
                      {group.length === 1 ? 'item' : 'items'}
                    </span>
                  </>
                </div>
                <div class="product-grid">
                  {group.map((product) => {
                    const hasPhoto = Boolean(getProductPhoto(product.imageId));
                    return hasPhoto ? (
                      <ProductCard
                        productPage={product}
                        href={`/gear/${product.slug}/`}
                      />
                    ) : (
                      <article class="research-link-card">
                        <h3>
                          <a href={`/gear/${product.slug}/`}>{product.name}</a>
                        </h3>
                        <p>{product.summary}</p>
                        <p class="small-print">
                          A product photo is not available yet.
                        </p>
                        <a class="text-link" href={`/gear/${product.slug}/`}>
                          Read the research
                        </a>
                      </article>
                    );
                  })}
                </div>
              </>
            </section>
          ) : null;
        })
      }
    </div>
  </section>
  <section class="section section-tint">
    <div class="container narrow-copy">
      <h2>How to use the notes</h2><p>
        Start with what owners report, then check the specifications and
        trade-offs. Listed figures come from sellers and manufacturers until
        we've measured them ourselves. External merchants set current
        prices, delivery, returns and warranty.
      </p><a class="button" href="/#value">See the Value Kit</a>
    </div>
  </section>
</BaseLayout>
