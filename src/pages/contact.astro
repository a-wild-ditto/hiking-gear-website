---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Contact Bush Gums"
  description="Contact Bush Gums with product feedback, research corrections or hiking questions."
>
  <article class="content-page">
    <div class="container narrow prose">
      <span class="eyebrow">Contact</span>
      <h1>Help us keep the research useful.</h1>
      <p class="lead">
        Send product feedback, a correction request, a question about the
        research or a relevant owner experience.
      </p>
      {
        site.contactEmail && (
          <div class="info-card">
            <>
              <h2>Email</h2>
              <p>
                <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
              </p>
            </>
          </div>
        )
      }
      <p class="small-print">
        Bush Gums is not the merchant. Please contact the external merchant for
        an order, delivery, return or warranty question.
      </p>
    </div>
  </article>
</BaseLayout>
