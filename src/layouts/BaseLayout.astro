---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import socialImage from '../assets/images/blue-mountains-hero.png';
import '../styles/global.css';
const {
  title = site.title,
  description = site.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const socialImageUrl = new URL(socialImage.src, site.url).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brandName,
  url: site.url,
  description: site.description,
  inLanguage: 'en-AU',
};
---

<!doctype html>
<html
  lang="en-AU"
  style={`--ink:${site.theme.ink};--forest:${site.theme.forest};--moss:${site.theme.moss};--sand:${site.theme.sand};--clay:${site.theme.clay};--paper:${site.theme.paper};--white:${site.theme.white}`}
>
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    />
    <meta name="description" content={description} />{
      noindex && <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/favicon.svg"
    />
    <meta property="og:type" content="website" /><meta
      property="og:locale"
      content="en_AU"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={socialImageUrl}
    /><meta
      property="og:image:width"
      content={String(socialImage.width)}
    /><meta
      property="og:image:height"
      content={String(socialImage.height)}
    /><meta
      property="og:image:alt"
      content="A tent overlooking an Australian mountain landscape at sunrise"
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:image"
      content={socialImageUrl}
    /><meta
      name="twitter:image:alt"
      content="A tent overlooking an Australian mountain landscape at sunrise"
    /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
    <title>{title}</title>
  </head>
  <body
    ><a class="skip-link" href="#main">Skip to content</a><Header /><main
      id="main"
    >
      <slot />
    </main><Footer /></body
  >
</html>
