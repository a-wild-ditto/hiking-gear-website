---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, themeCss } from '../config/site';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/outfit/wght.css';
import socialImage from '../assets/images/blue-mountains-hero.png';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
const {
  title = site.title,
  description = site.description,
  noindex = false,
  nofollow = false,
  ogType = 'website',
  socialImage: pageSocialImage = socialImage,
  socialImageAlt = 'A tent overlooking an Australian mountain landscape at sunrise',
  schema: extraSchema,
} = Astro.props as {
  title?: string;
  description?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: 'website' | 'article';
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  schema?: object;
};
const canonical = new URL(Astro.url.pathname, site.url).toString();
const socialImageUrl = new URL(pageSocialImage.src, site.url).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brandName,
  url: site.url,
  description: site.description,
  inLanguage: 'en-AU',
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" /><meta
      name="commission-factory-verification"
      content="810a4e1ba79b40b0b56f1885d89bb1ed"
    /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />{
      noindex && (
        <meta
          name="robots"
          content={`noindex, ${nofollow ? 'nofollow' : 'follow'}`}
        />
      )
    }
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/favicon.svg"
    />
    <meta property="og:type" content={ogType} /><meta
      property="og:locale"
      content="en_AU"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={socialImageUrl}
    /><meta
      property="og:image:width"
      content={String(pageSocialImage.width)}
    /><meta
      property="og:image:height"
      content={String(pageSocialImage.height)}
    /><meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:image"
      content={socialImageUrl}
    /><meta name="twitter:image:alt" content={socialImageAlt} /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
    {
      extraSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(extraSchema)}
        />
      )
    }
    <style is:inline set:html={themeCss}></style>
    <meta name="theme-color" content="#1c3328" />
    <title>{title}</title>
    <script>
      import { shouldEnableAnalytics } from '../config/analytics';

      if (
        shouldEnableAnalytics() &&
        window.location.pathname !== '/build-my-kit/'
      ) {
        window.clarity =
          window.clarity ||
          function (...args: unknown[]) {
            (window.clarity!.q = window.clarity!.q || []).push(args);
          };
        const clarityScript = document.createElement('script');
        clarityScript.async = true;
        clarityScript.src = 'https://www.clarity.ms/tag/yk49dw3tso';
        document.head.append(clarityScript);
      }
    </script>
  </head>
  <body
    ><a class="skip-link" href="#main">Skip to content</a><Header /><main
      id="main"
    >
      <slot />
    </main><Footer /><script>
      import '../scripts/reveal.ts';
      import '../scripts/analytics.ts';
    </script></body
  >
</html>
