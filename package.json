{
  "name": "trailwise-validation-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static-first validation website for a beginner-focused Australian hiking gear concept.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy:check": "node scripts/check-deploy-config.mjs",
    "deploy": "npm run deploy:check && npm run build && npx wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2"
  }
}
